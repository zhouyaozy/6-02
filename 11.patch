+package org.apache.iceberg;
+
+import java.io.Serializable;
+import java.util.Map;
+import org.apache.iceberg.relocated.com.google.common.collect.ImmutableMap;
+import org.apache.iceberg.util.PropertyUtil;
+
+/**
+ * A generic configuration manager that handles properties with default values and type-safe
+ * access.
+ */
+public class ConfigManager implements Serializable {
+
+  public static final String ROOT_DIR = "root-dir";
+  public static final String ROOT_DIR_DEFAULT = "/tmp";
+
+  public static final String SERVER_PORT = "server.port";
+  public static final int SERVER_PORT_DEFAULT = 9393;
+
+  public static final String ENABLED = "enabled";
+  public static final boolean ENABLED_DEFAULT = true;
+
+  public static final String TIMEOUT_MS = "timeout-ms";
+  public static final long TIMEOUT_MS_DEFAULT = 30000L;
+
+  private final Map<String, String> properties;
+
+  public ConfigManager() {
+    this(ImmutableMap.of());
+  }
+
+  public ConfigManager(Map<String, String> properties) {
+    this.properties = ImmutableMap.copyOf(properties);
+  }
+
+  public String rootDir() {
+    return PropertyUtil.propertyAsString(properties, ROOT_DIR, ROOT_DIR_DEFAULT);
+  }
+
+  public int serverPort() {
+    return PropertyUtil.propertyAsInt(properties, SERVER_PORT, SERVER_PORT_DEFAULT);
+  }
+
+  public boolean enabled() {
+    return PropertyUtil.propertyAsBoolean(properties, ENABLED, ENABLED_DEFAULT);
+  }
+
+  public long timeoutMs() {
+    return PropertyUtil.propertyAsLong(properties, TIMEOUT_MS, TIMEOUT_MS_DEFAULT);
+  }
+
+  public String get(String property) {
+    return properties.get(property);
+  }
+
+  public String getOrDefault(String property, String defaultValue) {
+    return properties.getOrDefault(property, defaultValue);
+  }
+
+  public int getAsInt(String property, int defaultValue) {
+    return PropertyUtil.propertyAsInt(properties, property, defaultValue);
+  }
+
+  public long getAsLong(String property, long defaultValue) {
+    return PropertyUtil.propertyAsLong(properties, property, defaultValue);
+  }
+
+  public boolean getAsBoolean(String property, boolean defaultValue) {
+    return PropertyUtil.propertyAsBoolean(properties, property, defaultValue);
+  }
+
+  public Map<String, String> getPropertiesWithPrefix(String prefix) {
+    return PropertyUtil.propertiesWithPrefix(properties, prefix);
+  }
+}
